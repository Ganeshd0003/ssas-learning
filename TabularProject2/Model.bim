              "type": "query",
              "query": " \t\t\t\tSELECT [gold].[fact_sales].*   FROM [gold].[fact_sales] ",
              "dataSource": "SqlServer GANESHSQLEXPRESS DataWarehouse"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Number of Customers",
            "expression": " COUNT(dim_customers[customer_key])"
          },
          {
            "name": "Total Numbef of Products",
            "expression": " COUNT(dim_products[product_id])"
          },
          {
            "name": "Total Numbef of Orders",
            "expression": " COUNT(fact_sales[order_number])"
          },
          {
            "name": "Total Quantity Saled",
            "expression": " COUNT(fact_sales[quantity])"
          },
          {
            "name": "Total Sales Amount",
            "expression": " SUM(fact_sales[sales_amount])"
          },
          {
            "name": "Most Expensive Item Price",
            "expression": " MAX(fact_sales[price])"
          },
          {
            "name": "Most Affordable Item Price",
            "expression": " MIN(fact_sales[price])"
          },
          {
            "name": "Average Price of Item",
            "expression": " AVERAGE(fact_sales[price])"
          },
          {
            "name": "Female Sales",
            "expression": " CALCULATE([Total Sales Amount],dim_customers[gender] = \"Female\")"
          },
          {
            "name": "Male Sales",
            "expression": " CALCULATE([Total Sales Amount],dim_customers[gender] = \"Male\")"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [gold].[fact_sales].*   FROM [gold].[fact_sales] "
